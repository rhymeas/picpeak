FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci --legacy-peer-deps

COPY . .
RUN npm run build

FROM nginx:1.30-alpine

ARG CACHEBUST=1
RUN echo "cachebust=${CACHEBUST}" && apk upgrade --no-cache
RUN apk add --no-cache curl gettext

RUN rm -rf /etc/nginx/conf.d/*
COPY nginx.conf /tmp/picpeak-nginx.conf

# PicPeak's stock config targets Docker Compose. Railway requires its private
# service hostname and IPv6 DNS resolver so backend IP changes stay transparent.
RUN sed \
      -e 's#set \$backend_upstream backend;#set \$backend_upstream picpeak-backend.railway.internal;#g' \
      -e 's#resolver 127\.0\.0\.11 valid=10s ipv6=off;#resolver [fd12::10] valid=10s ipv4=off;#' \
      /tmp/picpeak-nginx.conf > /etc/nginx/conf.d/default.conf \
    && rm /tmp/picpeak-nginx.conf

COPY --from=builder /app/dist /usr/share/nginx/html

# Railway runs the image read-only as nginx, so render branding at build time.
RUN export BRAND_TITLE='TravelBlogr Photos' \
      BRAND_DESCRIPTION='Private event photos shared with TravelBlogr.' \
    && envsubst '${BRAND_TITLE} ${BRAND_DESCRIPTION}' \
      < /usr/share/nginx/html/index.html \
      > /usr/share/nginx/html/index.html.rendered \
    && mv /usr/share/nginx/html/index.html.rendered /usr/share/nginx/html/index.html

RUN chown -R nginx:nginx /usr/share/nginx/html \
    && chown -R nginx:nginx /var/cache/nginx \
    && chown -R nginx:nginx /var/log/nginx \
    && touch /var/run/nginx.pid \
    && chown -R nginx:nginx /var/run/nginx.pid

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost/health || exit 1

USER nginx

CMD ["nginx", "-g", "daemon off;"]
